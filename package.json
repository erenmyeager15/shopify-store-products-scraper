{
  "name": "shopify-store-products-scraper",
  "version": "1.0.0",
  "description": "Apify Actor that extracts products and prices from authorized Shopify storefronts via the public products.json endpoint",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "apify",
    "shopify",
    "ecommerce",
    "products",
    "scraper",
    "crawlee"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@crawlee/http": "^3.17.0",
    "apify": "^3.2.0",
    "ipaddr.js": "^2.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
